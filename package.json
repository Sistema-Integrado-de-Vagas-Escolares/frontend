    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "wrangler": "^4.54.0"
